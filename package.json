{
  "name": "pipeseal-monorepo",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build --noEmit",
    "format": "prettier --write \"packages/**/*.ts\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"docs/**/*.md\"",
    "setup:mcp": "node scripts/setup-mcp.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "^3.5.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@10.19.0"
}
